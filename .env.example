# Postgres
DATABASE_URL=postgresql+psycopg://devuser:devpassword@localhost:5432/devdb


# Embedding 
EMBEDDING_BASE_URL=http://localhost:3838/v1
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Cross Encoder
CROSS_ENCODER_URL=http://localhost:7000
CROSS_ENCODER_MODEL=BAAI/bge-reranker-large

# Vector DB
CHROMA_HOST=localhost
CHROMA_PORT=8080
CHROMA_COLLECTION=chunks

# LLM
LLM_MODEL=qwen2.5-7b-instruct
LLM_BASE_URL=http://127.0.0.1:1234/v1



# Langfuse (optional)
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="http://localhost:3000"